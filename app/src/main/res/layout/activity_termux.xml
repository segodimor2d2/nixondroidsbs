<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:background="@android:color/black">

                <FrameLayout
                    android:id="@+id/terminal_eye_left"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusableInTouchMode="true"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />

                </FrameLayout>
                <FrameLayout
                    android:id="@+id/terminal_eye_right"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                <com.termux.view.TerminalMirrorView
                    android:id="@+id/terminal_mirror_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_settings"
                        android:background="@null"
                        android:contentDescription="@string/action_open_settings"
                        app:tint="?attr/termuxActivityDrawerImageTint" />
                    <Button
                        android:id="@+id/toggle_display_adjustments"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/show_display_adjustments"
                        android:textColor="@android:color/white"
                        android:backgroundTint="@android:color/black"
                        app:backgroundTint="@android:color/black" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/display_adjustment_scroll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="140dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/vr_alignment_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/screen_padding_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <Button
                                android:textColor="@android:color/white"
                                android:backgroundTint="@android:color/black"
                                app:backgroundTint="@android:color/black"
                                android:id="@+id/screen_padding_minus"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/decrease_display_adjustment"
                                android:text="−" />
                            <Space
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="1dp" />
                            <Button
                                android:textColor="@android:color/white"
                                android:backgroundTint="@android:color/black"
                                app:backgroundTint="@android:color/black"
                                android:id="@+id/screen_padding_plus"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/increase_display_adjustment"
                                android:text="+" />
                        </LinearLayout>

                    <TextView
                        android:id="@+id/eye_padding_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/eye_padding_minus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/decrease_display_adjustment"
                            android:text="−" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/eye_padding_plus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/increase_display_adjustment"
                            android:text="+" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/left_inner_padding_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/left_inner_padding_minus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/decrease_display_adjustment"
                            android:text="−" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/left_inner_padding_plus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/increase_display_adjustment"
                            android:text="+" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/right_inner_padding_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/right_inner_padding_minus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/decrease_display_adjustment"
                            android:text="−" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/right_inner_padding_plus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/increase_display_adjustment"
                            android:text="+" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/vr_alignment_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/vr_alignment_minus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/decrease_display_adjustment"
                            android:text="−" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp" />
                        <Button
                            android:textColor="@android:color/white"
                            android:backgroundTint="@android:color/black"
                            app:backgroundTint="@android:color/black"
                            android:id="@+id/vr_alignment_plus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/increase_display_adjustment"
                            android:text="+" />
                    </LinearLayout>
                </LinearLayout>

                    <Button
                        android:id="@+id/reset_display_adjustments"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/reset_display_adjustments"
                        android:textColor="@android:color/white"
                        android:backgroundTint="@android:color/black"
                        app:backgroundTint="@android:color/black" />
                    </LinearLayout>
                </ScrollView>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggle_keyboard_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:background="@color/black"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
